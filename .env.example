APP_NAME=Enterprise AI Knowledge & Workflow Agent
APP_VERSION=1.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://enterprise:enterprise@localhost:5432/enterprise_ai_agent
DATABASE_CONNECT_TIMEOUT_SECONDS=3
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
SQL_QUERY_TIMEOUT_MS=5000
SQL_ROW_LIMIT=100

LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LLM_TEMPERATURE=0

CHROMA_PATH=./data/processed/chroma
DOCUMENTS_PATH=./data/documents
UPLOAD_MAX_MB=5
RETRIEVAL_TOP_K=4
RETRIEVAL_SCORE_THRESHOLD=0.25
